{{- $work := promptBoolOnce . "work" "Work machine" -}}
{{- $name := promptStringOnce . "name" "Git name" "Connor Sullivan" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}

sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
work = {{ $work }}
name = {{ $name | quote }}
email = {{ $email | quote }}

[diff]
pager = "delta"
