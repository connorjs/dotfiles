#!/bin/bash
# Re-runs whenever the Brewfile changes: {{ include "dot_Brewfile" | sha256sum }}
set -euo pipefail

if ! command -v brew > /dev/null; then
	/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	eval "$(/opt/homebrew/bin/brew shellenv)"
fi

brew analytics off
# Warn instead of failing so one bad cask (e.g. an app installed outside brew) does not block the rest
brew bundle --file={{ joinPath .chezmoi.sourceDir "dot_Brewfile" | quote }} || echo '⚠️  brew bundle reported failures (see above)'
